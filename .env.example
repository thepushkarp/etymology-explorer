# Etymology Explorer Environment Variables

# ===========================================
# OpenRouter API Key (required)
# ===========================================
# Server-side key for OpenRouter Responses API access
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional Exa source recovery and targeted dictionary discovery.
# Missing key or EXA_ENABLED=false disables Exa only. Redis is required for
# Exa's separate $10 UTC-calendar-month budget; uncertain charges retain their
# reserved tariff allowance. Use a dedicated production key with a $10
# provider-side key budget (budgetCents=1000), whose billing period may differ.
EXA_API_KEY=
# EXA_ENABLED=true

# ===========================================
# Admin Secret (required for /api/admin/stats)
# ===========================================
# Any random string — used to authenticate admin stats endpoint
ADMIN_SECRET=

# ===========================================
# Upstash KV (optional - for caching + rate limiting)
# ===========================================
# Create a free Redis database at https://upstash.com
# Enables: result caching, rate limiting, and monthly budget enforcement
# Note: without Redis, uncached /api/etymology searches return 503 (fail
# closed — no budget enforcement or deduplication is possible without it)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ===========================================
# ElevenLabs TTS (optional - for pronunciation audio)
# ===========================================
# Get API key at https://elevenlabs.io
# Optional preferred voice shared by all languages; stock female voices provide fallback.
# Catalog access is required when no voice is configured or a voice is unavailable.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ===========================================
# Feature Flags (optional — all default to enabled/false)
# ===========================================
# PUBLIC_SEARCH_ENABLED=true
# PRONUNCIATION_ENABLED=true
# FORCE_CACHE_ONLY=false
# Set to false to disable per-IP rate limiting (e.g. for local load testing)
# RATE_LIMIT_ENABLED=true
